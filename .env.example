# Публичный API Pinhead (каталог товаров). Stage: https://api-stage.pnhd.ru
NEXT_PUBLIC_PNHD_API_URL=https://api.pnhd.ru

# Яндекс.Метрика (номер счётчика). Пусто — события пишутся в консоль браузера.
NEXT_PUBLIC_YM_COUNTER_ID=

# Прайс DTF: tiered (по умолчанию) — со скидкой за тираж, site — таблица с главной сайта.
NEXT_PUBLIC_PRICE_SOURCE=

# Куда отправлять заявки. Ничего не задано — заявка пишется в лог сервера.
# Битрикс24: адрес входящего вебхука с правами CRM, вида https://<портал>.bitrix24.ru/rest/<id>/<ключ>/
ORDER_BITRIX_WEBHOOK=
# id воронки сделок; пусто — воронка по умолчанию.
ORDER_BITRIX_CATEGORY_ID=
# Telegram: используется, если Битрикс не задан или недоступен.
ORDER_TELEGRAM_BOT_TOKEN=
ORDER_TELEGRAM_CHAT_ID=
